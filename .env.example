# Private workspace. Run python3 scripts/setup_config.py to generate this key.
MIROFISH_ACCESS_KEY=
MIROFISH_COOKIE_SECURE=false
# For remote HTTPS, add the browser-facing origin and enable secure cookies.
MIROFISH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5001,http://127.0.0.1:5001
FLASK_DEBUG=false

# Ollama Cloud through a signed-in LOCAL Ollama daemon (verified route).
# Run ollama signin, then select a cloud alias from ollama list.
# Docker Desktop: change 127.0.0.1 to host.docker.internal to reach the host.
LLM_PROVIDER=openai_compatible
LLM_API_KEY=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL_NAME=gpt-oss:20b-cloud
LLM_TOKEN_LIMIT=32768

# Direct hosted Ollama alternative: set LLM_PROVIDER=ollama_cloud,
# LLM_BASE_URL=https://ollama.com/v1, clear LLM_API_KEY, and set OLLAMA_API_KEY.
# Select the model ID returned by check_llm_provider.py --list-models.
OLLAMA_API_KEY=

# Required for document ingestion / knowledge graphs. Documents go to Zep Cloud.
ZEP_API_KEY=

# Optional separate boost provider: leave ALL fields empty to use the primary.
LLM_BOOST_PROVIDER=
LLM_BOOST_API_KEY=
LLM_BOOST_BASE_URL=
LLM_BOOST_MODEL_NAME=
LLM_BOOST_TOKEN_LIMIT=

# Small initial runs; each agent action can incur hosted model usage.
OASIS_DEFAULT_MAX_ROUNDS=10
