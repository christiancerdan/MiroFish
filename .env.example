# Private workspace. Run python3 scripts/setup_config.py to generate this key.
MIROFISH_ACCESS_KEY=
MIROFISH_COOKIE_SECURE=false
# For remote HTTPS, add the browser-facing origin and enable secure cookies.
MIROFISH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5001,http://127.0.0.1:5001
FLASK_DEBUG=false

# Ollama Cloud through a signed-in LOCAL Ollama daemon (verified route).
# Run ollama signin, then select a cloud alias from ollama list.
# Docker Desktop: change 127.0.0.1 to host.docker.internal to reach the host.
LLM_PROVIDER=openai_compatible
LLM_API_KEY=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL_NAME=gpt-oss:20b-cloud
LLM_TOKEN_LIMIT=32768

# Direct hosted Ollama alternative: set LLM_PROVIDER=ollama_cloud,
# LLM_BASE_URL=https://ollama.com/v1, clear LLM_API_KEY, and set OLLAMA_API_KEY.
# Select the model ID returned by check_llm_provider.py --list-models.
OLLAMA_API_KEY=

# Memory belongs to this workspace by default; no Zep account is needed.
GRAPH_BACKEND=local
# Optional cloud alternative: GRAPH_BACKEND=zep, then set ZEP_API_KEY.
# Changing backends does not migrate existing graphs automatically.
ZEP_API_KEY=

# Optional separate boost provider: leave ALL fields empty to use the primary.
LLM_BOOST_PROVIDER=
LLM_BOOST_API_KEY=
LLM_BOOST_BASE_URL=
LLM_BOOST_MODEL_NAME=
LLM_BOOST_TOKEN_LIMIT=

# Small initial runs; each agent action can incur hosted model usage.
OASIS_DEFAULT_MAX_ROUNDS=10

# Persistent per-project model limits. The workspace controls can raise these.
# Idle time between stages does not count toward active model time.
BUDGET_MAX_CALLS=1000
BUDGET_MAX_TOKENS=1000000
BUDGET_MAX_OUTPUT_TOKENS=250000
BUDGET_MAX_WALL_SECONDS=3600
# Set exact model input_per_million/output_per_million rates to estimate USD.
# Subscription pricing is not inferred. Leave the cost cap empty if unpriced.
BUDGET_MODEL_PRICING_JSON={}
BUDGET_MAX_COST_USD=

# Queued jobs recover on server start; interrupted side effects require retry.
JOB_WORKERS=2
JOB_LEASE_SECONDS=60
# Per-simulation process limits, separate from cumulative project model limits.
SIMULATION_MAX_WALL_SECONDS=3600
SIMULATION_MAX_CPU_SECONDS=1800
SIMULATION_MAX_MEMORY_MB=8192
